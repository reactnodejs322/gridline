# macOS metadata
.DS_Store

# SwiftPM local state and build products
.swiftpm/
**/.build/

# Locally built macOS application bundles
*.app/

# Gridline Debug runtime events, reports, and build diagnostics
**/events.jsonl
**/timeline.jsonl
gridline_debug/user-log-view.json
**/build/
**/reports/*
!**/reports/.gitkeep
/hot-reload-logs.md
**/__pycache__/
**/hook_vendor/ponytail/
**/hook_vendor/.ponytail-upstream/
**/hook_vendor/.ponytail-stage-*/
**/hook_vendor/.ponytail-previous/

# Model assets for every skill are fetched into resources/models by setup scripts.
**/resources/models/**
!**/resources/models/
!**/resources/models/**/
!**/resources/models/**/*.md
!**/resources/models/**/LICENSE
!**/resources/models/**/config.json

# Generated status for running versioned app copies
/gridline_versions/runtime-status.json
